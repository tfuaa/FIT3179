{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Deaths Attributed to Air Pollution per 100,000 People",
  "width": 600,
  "height": 310,
  "projection": {
    "type": "equalEarth"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/tfuaa/FIT3179/refs/heads/main/ne_110m_admin_0_countries.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_110m_admin_0_countries"
    }
  },
  "transform": [
    {
      "calculate": "datum.properties.ISO_A3 == '-99' ? datum.properties.ADM0_A3 : datum.properties.ISO_A3",
      "as": "code"
    },
    {
      "lookup": "code",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/tfuaa/FIT3179/refs/heads/main/air-pollution-deaths-2021-clean.csv"
        },
        "key": "CountryCode",
        "fields": [
          "NumberofDeaths",
          "Population"
        ]
      }
    },
    {
      "calculate": "datum.NumberofDeaths / datum.Population * 100000",
      "as": "Deaths per 100,000"
    }
  ],
  "mark": {
    "type": "geoshape",
    "invalid": null,
    "stroke": "white",
    "strokeWidth": 0.3
  },
  "encoding": {
    "color": {
      "field": "Deaths per 100,000",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "scheme": "orangered"
      },
      "legend": {
        "format": ".0f"
      },
      "condition": {
        "test": "!isValid(datum['Deaths per 100,000'])",
        "value": "#d9d9d9"
      }
    },
    "tooltip": [
      {
        "field": "properties.NAME",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "Deaths per 100,000",
        "type": "quantitative",
        "format": ".1f"
      },
      {
        "field": "NumberofDeaths",
        "type": "quantitative",
        "title": "Deaths",
        "format": ",.0f"
      },
      {
        "field": "Population",
        "type": "quantitative",
        "format": ","
      }
    ]
  }
}
