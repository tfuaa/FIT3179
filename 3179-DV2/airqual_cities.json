{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Latest annual air pollution in cities worldwide",
    "subtitle": "Most recent year with data for each city (2024 or 2025); colour shows multiples of the WHO 2021 annual guideline"
  },
  "width": 700,
  "height": 380,
  "projection": {
    "type": "equalEarth"
  },
  "params": [
    {
      "name": "pollutant_sel",
      "value": "PM2.5",
      "bind": {
        "input": "select",
        "options": [
          "PM2.5",
          "PM10",
          "NO2"
        ],
        "labels": [
          "PM2.5 (guideline 5 µg/m³)",
          "PM10 (guideline 15 µg/m³)",
          "NO2 (guideline 10 µg/m³)"
        ],
        "name": "Pollutant: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tfuaa/FIT3179/refs/heads/main/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e4e4e4",
        "stroke": "#ffffff",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tfuaa/FIT3179/refs/heads/main/who_air_quality_2024_2025.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "fold": [
            "pm25_concentration",
            "pm10_concentration",
            "no2_concentration"
          ],
          "as": [
            "pollutant_raw",
            "value"
          ]
        },
        {
          "filter": "isValid(datum.value) && datum.value >= 0.5 && datum.value <= 1000 && isValid(datum.latitude) && isValid(datum.longitude)"
        },
        {
          "calculate": "datum.pollutant_raw === 'pm25_concentration' ? 'PM2.5' : datum.pollutant_raw === 'pm10_concentration' ? 'PM10' : 'NO2'",
          "as": "pollutant"
        },
        {
          "filter": "datum.pollutant === pollutant_sel"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "year",
              "as": "latest"
            }
          ],
          "groupby": [
            "iso3",
            "city"
          ]
        },
        {
          "filter": "datum.year === datum.latest"
        },
        {
          "calculate": "datum.value / (datum.pollutant === 'PM2.5' ? 5 : datum.pollutant === 'PM10' ? 15 : 10)",
          "as": "ratio"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "size": 28,
        "stroke": "#222",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "order": {
          "field": "ratio",
          "type": "quantitative"
        },
        "color": {
          "field": "ratio",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              1,
              2,
              3,
              5,
              7
            ],
            "range": [
              "#2a9d8f",
              "#ffe08a",
              "#fdae61",
              "#f46d43",
              "#d73027",
              "#7f0000"
            ]
          },
          "legend": {
            "title": "Times(x) over the WHO guideline",
            "orient": "bottom-left"
          }
        },
        "tooltip": [
          {
            "field": "city",
            "title": "City"
          },
          {
            "field": "country_name",
            "title": "Country"
          },
          {
            "field": "pollutant",
            "title": "Pollutant"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Annual mean (µg/m³)",
            "format": ".1f"
          },
          {
            "field": "ratio",
            "type": "quantitative",
            "title": "× WHO guideline",
            "format": ".1f"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          }
        ]
      }
    }
  ]
}